{
  "manifest_version": 3,
  "name": "Auto PiP for Safari",
  "version": "1.0.0",
  "description": "다른 탭으로 이동하면 재생 중인 영상을 PIP로, 돌아오면 원래 화면으로.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "scripts": ["shared.js", "background.js"]
  },
  "action": {
    "default_title": "Auto PiP",
    "default_popup": "popup.html",
    "default_icon": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png"}
  },
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "64": "icons/icon-64.png", "128": "icons/icon-128.png", "256": "icons/icon-256.png", "512": "icons/icon-512.png"},
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["shared.js", "pip-core.js", "content.js"],
    "run_at": "document_start",
    "all_frames": true
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
